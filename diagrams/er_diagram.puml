@startuml
hide circle
skinparam linetype ortho

' Таблицы
entity "Role (Роль)" as role {
  * role_id : INTEGER «PK»
  --
  role_name : TEXT «NOT NULL»
}

entity "User (Пользователь)" as user {
  * user_id : INTEGER «PK»
  --
  role_id : INTEGER «FK»
  login : TEXT «NOT NULL»
  password_hash : TEXT «NOT NULL»
}

entity "Room (Номер)" as room {
  * room_id : INTEGER «PK»
  --
  number : TEXT «NOT NULL»
  type : TEXT «NOT NULL»
  price_per_day : REAL «NOT NULL»
  status : TEXT «NOT NULL»
}

entity "Guest (Клиент)" as guest {
  * guest_id : INTEGER «PK»
  --
  first_name : TEXT «NOT NULL»
  last_name : TEXT «NOT NULL»
  phone : TEXT «NOT NULL»
}

entity "Booking (Бронирование)" as booking {
  * booking_id : INTEGER «PK»
  --
  guest_id : INTEGER «FK»
  room_id : INTEGER «FK»
  check_in_date : TEXT «NOT NULL»
  check_out_date : TEXT «NOT NULL»
  total_price : REAL «NOT NULL»
  status : TEXT «NOT NULL»
}

' Связи
role ||--o{ user
guest ||--o{ booking
room ||--o{ booking

@enduml